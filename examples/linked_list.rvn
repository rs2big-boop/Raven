// This is a simple example of a Raven program that prints "Hello, World!" and performs some basic operations.
class Node {
    value
    next

    // Constructor: single argument (no next pointer)
    fn Node(v) {
        this.value = v
        this.next = null
    }

    // Constructor: two arguments (with next pointer)
    fn Node(v, n) {
        this.value = v
        this.next = n
    }

    fn is_null() {
        return this.next is null
    }

    fn set_next(n) {
        this.next = n
    }

    fn set_value(v) {
        this.value = v
    }

    fn get_next() {
        return this.next
    }

    fn get_value() {
        return this.value
    }
    fn show() {
        println "Node value: " + this.value
        if (this.next is null) {
            println "Next node: null"
        } else {
            println "Next node value: " + this.next.get_value()
        }
    }
}

let node1 = Node(1, null)
let node2 = Node(2, node1)
node1.show()
node2.show()