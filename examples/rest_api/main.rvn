import "stdlib/net/http";
import "stdlib/encoding/json";

print("Raven REST API Client Demo");
let mock_response = "{\"status\": \"ok\", \"code\": 200, \"data\": [{\"id\": 1, \"name\": \"Raven\"}]}";
let parsed = parse_json(mock_response);

print("Response status: " + str(parsed["status"]));
print("Response code: " + str(parsed["code"]));
print("Payload: " + str(parsed["data"]));
