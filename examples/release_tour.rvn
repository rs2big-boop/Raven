// Raven Release Tour - Showcase of Modern Features
import "stdlib/math";
import "stdlib/string_utils";
import "stdlib/sort";

// 1. Structs / Object Types
struct User { name, role, karma };

let admin = User("Ran", "Lead Architect", 9000);
print(f"User: {admin.name} | Role: {admin.role} | Karma: {admin.karma}");

// 2. Pattern Matching with Type & Roles
let access_level = match (admin.role) {
    "Lead Architect" => "Full Root Access",
    "Developer"      => "Repository Write",
    _                => "Read Only"
};
print(f"Access Level: {access_level}");

// 3. String Interpolation with Expressions
let score = 98.6;
print(f"Candidate passed: {score >= 80} with score: {score}%");

// 4. In-Place Sorting & String Utilities
let numbers = [42, 17, 99, 8, 23];
sort_arr(numbers);
print(f"Sorted numbers: {numbers}");

let filename = "server_config.rvn";
print(f"Is Raven source file? {ends_with(filename, \".rvn\")}");

// 5. Functional Pipeline
let sum_even_squares = [1, 2, 3, 4, 5, 6]
    |> fn(arr) { return filter(arr, fn(x) { return x % 2 == 0; }); }
    |> fn(arr) { return map(arr, fn(x) { return x * x; }); }
    |> fn(arr) { return reduce(arr, fn(acc, x) { return acc + x; }, 0); };

print(f"Sum of even squares: {sum_even_squares}");
print("🐦‍⬛ Raven is ready for production!");
