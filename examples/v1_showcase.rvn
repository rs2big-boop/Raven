// examples/v1_showcase.rvn — Showcase of Raven v1.0.0 Modern Features
import "stdlib/event";
import "stdlib/cache";
import "stdlib/validate";

println("🐦 === Raven v1.0.0 Modern Language Features Showcase === 🐦\n");

// 1. Default Parameters
fn greet(name = "World", role = "Explorer") {
    return "Hello, " + name + "! Welcome as " + role + ".";
}
println("1. Default Function Parameters:");
println("   " + greet());
println("   " + greet("Antigravity", "Architect"));
println("");

// 2. Null Coalescing (??)
let env_port = nil;
let port = env_port ?? 8080;
println("2. Null Coalescing Operator (??):");
println("   Configured port: " + port);
println("");

// 3. Optional Chaining (?.)
let session = nil;
let user_name = session?.user?.name ?? "Guest";
let first_item = session?.cart?.[0] ?? "Empty cart";
println("3. Optional Chaining (?.):");
println("   User: " + user_name);
println("   First item: " + first_item);
println("");

// 4. 'is' Type Checking Operator
println("4. 'is' Type Introspection Operator:");
let val1 = 3.14159;
let val2 = "Corvus Engine";
let val3 = [1, 2, 3];
if (val1 is Number) { println("   val1 is Number: true"); }
if (val2 is String) { println("   val2 is String: true"); }
if (val3 is Array)  { println("   val3 is Array: true"); }
println("");

// 5. Spread Operator (...)
let base_arr = [1, 2, 3];
let full_arr = [0, ...base_arr, 4, 5];
println("5. Spread Operator (...):");
println("   Full Array: " + str(full_arr));

let base_map = {"a": 1, "b": 2};
let full_map = {...base_map, "c": 3, "b": 99};
println("   Merged Map: b = " + full_map["b"] + ", c = " + full_map["c"]);
println("");

// 6. 'loop {}' Infinite Loop with break
println("6. 'loop {}' Loop Construct:");
let count = 0;
loop {
    count += 1;
    if (count >= 3) {
        println("   Loop break at count = " + count);
        break;
    }
}
println("");

// 7. Multi-line Strings
let query = """
SELECT id, username, email
FROM users
WHERE active = true
ORDER BY created_at DESC;
""";
println("7. Multi-line Strings (\"\"\" ... \"\"\"):");
println("   Query:\n" + query);

// 8. Event Emitter stdlib
println("8. Event Emitter (stdlib/event):");
let emitter = create_emitter();
emitter.on("ready", fn(data) {
    println("   [Event] System is ready! Payload: " + str(data));
});
emitter.emit("ready", {"status": "ok", "version": "1.4.0"});
println("");

// 9. LRU Cache stdlib
println("9. LRU Cache (stdlib/cache):");
let cache = create_lru_cache(2);
cache.set("k1", 100);
cache.set("k2", 200);
println("   k1: " + cache.get("k1"));
cache.set("k3", 300); // Evicts k2
println("   k2 after eviction: " + str(cache.get("k2")));
println("   k3: " + cache.get("k3"));
println("");

println("✨ All Raven v1.4.0 features verified successfully! ✨");
