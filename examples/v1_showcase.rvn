// examples/v1_showcase.rvn — Showcase of Raven v1.0.0 Modern Features
import "stdlib/event";
import "stdlib/cache";
import "stdlib/validate";

print("🐦 === Raven v1.0.0 Modern Language Features Showcase === 🐦\n");

// 1. Default Parameters
fn greet(name = "World", role = "Explorer") {
    return "Hello, " + name + "! Welcome as " + role + ".";
}
print("1. Default Function Parameters:");
print("   " + greet());
print("   " + greet("Antigravity", "Architect"));
print("");

// 2. Null Coalescing (??)
let env_port = nil;
let port = env_port ?? 8080;
print("2. Null Coalescing Operator (??):");
print("   Configured port: " + port);
print("");

// 3. Optional Chaining (?.)
let session = nil;
let user_name = session?.user?.name ?? "Guest";
let first_item = session?.cart?.[0] ?? "Empty cart";
print("3. Optional Chaining (?.):");
print("   User: " + user_name);
print("   First item: " + first_item);
print("");

// 4. 'is' Type Checking Operator
print("4. 'is' Type Introspection Operator:");
let val1 = 3.14159;
let val2 = "Corvus Engine";
let val3 = [1, 2, 3];
if (val1 is Number) { print("   val1 is Number: true"); }
if (val2 is String) { print("   val2 is String: true"); }
if (val3 is Array)  { print("   val3 is Array: true"); }
print("");

// 5. Spread Operator (...)
let base_arr = [1, 2, 3];
let full_arr = [0, ...base_arr, 4, 5];
print("5. Spread Operator (...):");
print("   Full Array: " + str(full_arr));

let base_map = {"a": 1, "b": 2};
let full_map = {...base_map, "c": 3, "b": 99};
print("   Merged Map: b = " + full_map["b"] + ", c = " + full_map["c"]);
print("");

// 6. 'loop {}' Infinite Loop with break
print("6. 'loop {}' Loop Construct:");
let count = 0;
loop {
    count += 1;
    if (count >= 3) {
        print("   Loop break at count = " + count);
        break;
    }
}
print("");

// 7. Multi-line Strings
let query = """
SELECT id, username, email
FROM users
WHERE active = true
ORDER BY created_at DESC;
""";
print("7. Multi-line Strings (\"\"\" ... \"\"\"):");
print("   Query:\n" + query);

// 8. Event Emitter stdlib
print("8. Event Emitter (stdlib/event):");
let emitter = create_emitter();
emitter.on("ready", fn(data) {
    print("   [Event] System is ready! Payload: " + str(data));
});
emitter.emit("ready", {"status": "ok", "version": "1.0.0"});
print("");

// 9. LRU Cache stdlib
print("9. LRU Cache (stdlib/cache):");
let cache = create_lru_cache(2);
cache.set("k1", 100);
cache.set("k2", 200);
print("   k1: " + cache.get("k1"));
cache.set("k3", 300); // Evicts k2
print("   k2 after eviction: " + str(cache.get("k2")));
print("   k3: " + cache.get("k3"));
print("");

print("✨ All Raven v1.0.0 features verified successfully! ✨");
