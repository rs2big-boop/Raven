// Modern Raven Showcase: Pattern Matching & Standard Library Imports
import "stdlib/math";
import "stdlib/string";

print("=== Standard Library: Math ===");
let a = 15;
let b = 28;
print("max(" + a + ", " + b + ") = " + max(a, b));
print("min(" + a + ", " + b + ") = " + min(a, b));
print("pow(2, 8) = " + pow(2, 8));
print("factorial(6) = " + factorial(6));
print("clamp(120, 0, 100) = " + clamp(120, 0, 100));

print("");
print("=== Standard Library: String ===");
let repeated = repeat("Raven! ", 3);
print("repeated: " + repeated);
let formatted = pad_left("42", 6, "0");
print("padded number: " + formatted);

print("");
print("=== Pattern Matching (Rust-style) ===");
fn describe_http_status(code) {
    return match (code) {
        200 => "200 OK - Request succeeded",
        201 => "201 Created - Resource initialized",
        400 => "400 Bad Request - Syntax error",
        404 => "404 Not Found - Missing endpoint",
        500 => "500 Internal Server Error",
        _ => "Unknown status code"
    };
}

let codes = [200, 404, 500, 999];
for (let c in codes) {
    print(describe_http_status(c));
}
