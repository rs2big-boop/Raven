// benchmarks/concurrency/channel_throughput.rvn
import "stdlib/sync";

let ch = create_channel(100);
let count = 1000;

let t0 = time();
let i = 0;
while (i < count) {
    ch.send(i);
    let val = ch.recv();
    i = i + 1;
}
let elapsed = time() - t0;
print("Transferred " + str(count) + " messages in " + str(elapsed) + "s");
