// stdlib/container/ring.rvn - Circular list (inspired by Go's container/ring package)

fn create_ring(n) {
    let items = [];
    let i = 0;
    while (i < n) {
        push(items, nil);
        i += 1;
    }
    let cur = 0;
    let obj = {};

    obj.value = fn() {
        if (len(items) == 0) { return nil; }
        return items[cur];
    };

    obj.set_value = fn(v) {
        if (len(items) > 0) {
            items[cur] = v;
        }
    };

    obj.next = fn() {
        if (len(items) > 0) {
            cur = (cur + 1) % len(items);
        }
    };

    obj.prev = fn() {
        if (len(items) > 0) {
            cur = (cur - 1 + len(items)) % len(items);
        }
    };

    obj.len = fn() {
        return len(items);
    };

    return obj;
}
