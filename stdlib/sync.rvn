// stdlib/sync.rvn - Concurrency and synchronization primitives (inspired by Go's sync & CSP channels)

fn go(worker_fn) {
    return spawn(worker_fn);
}

fn create_channel(capacity) {
    if (capacity == nil) { capacity = 0; }
    let id = chan_create(capacity);
    let ch = {};
    ch["send"] = fn(val) { return chan_send(id, val); };
    ch["recv"] = fn() { return chan_recv(id); };
    ch["close"] = fn() { return chan_close(id); };
    ch["len"] = fn() { return chan_len(id); };
    ch["id"] = id;
    return ch;
}

fn create_wait_group() {
    let id = wg_create();
    let obj = {};

    obj["add"] = fn(delta) {
        return wg_add(id, delta);
    };

    obj["done"] = fn() {
        return wg_done(id);
    };

    obj["wait"] = fn() {
        return wg_wait(id);
    };

    obj["id"] = id;
    return obj;
}

fn create_mutex() {
    let id = mutex_create();
    let obj = {};

    obj["lock"] = fn() {
        return mutex_lock(id);
    };

    obj["unlock"] = fn() {
        return mutex_unlock(id);
    };

    obj["id"] = id;
    return obj;
}

fn create_once() {
    let executed = false;
    let obj = {};

    obj["do"] = fn(callback) {
        if (!executed) {
            executed = true;
            callback();
        }
    };

    return obj;
}
