// stdlib/sync.rvn - Concurrency and synchronization primitives (inspired by Go's sync & CSP channels)

fn go(worker_fn) {
    return spawn(worker_fn);
}

fn create_channel(capacity) {
    if (capacity == nil) { capacity = 0; }
    let id = chan_create(capacity);
    let ch = {};
    ch["send"] = fn(val) { return chan_send(id, val); };
    ch["recv"] = fn() { return chan_recv(id); };
    ch["close"] = fn() { return chan_close(id); };
    ch["len"] = fn() { return chan_len(id); };
    ch["id"] = id;
    return ch;
}

fn create_wait_group() {
    let counter = 0;
    let notify_ch = chan_create(100);
    let obj = {};

    obj["add"] = fn(delta) {
        counter += delta;
    };

    obj["done"] = fn() {
        counter -= 1;
        if (counter == 0) {
            chan_send(notify_ch, true);
        }
    };

    obj["wait"] = fn() {
        if (counter > 0) {
            chan_recv(notify_ch);
        }
    };

    obj["count"] = fn() {
        return counter;
    };

    return obj;
}

fn create_mutex() {
    let locked = false;
    let obj = {};

    obj["lock"] = fn() {
        if (locked) {
            panic("deadlock: mutex already locked");
        }
        locked = true;
    };

    obj["unlock"] = fn() {
        locked = false;
    };

    obj["is_locked"] = fn() {
        return locked;
    };

    return obj;
}

fn create_once() {
    let executed = false;
    let obj = {};

    obj["do"] = fn(callback) {
        if (!executed) {
            executed = true;
            callback();
        }
    };

    return obj;
}
