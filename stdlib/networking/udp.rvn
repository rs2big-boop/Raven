// stdlib/net/udp.rvn - Native UDP Datagram Socket utilities

fn udp_listen(host, port) {
    let fd = net_udp_bind(host, port);
    if (fd < 0) { return nil; }

    let sock = {};
    sock.fd = fd;
    sock.closed = false;

    sock.send_to = fn(target_host, target_port, data) {
        if (sock.closed) { return -1; }
        return net_udp_send_to(sock.fd, target_host, target_port, str(data));
    };

    sock.recv_from = fn(max_bytes) {
        if (sock.closed) { return nil; }
        if (max_bytes == nil) { max_bytes = 4096; }
        return net_udp_recv_from(sock.fd, max_bytes);
    };

    sock.close = fn() {
        if (!sock.closed) {
            sock.closed = true;
            net_udp_close(sock.fd);
        }
    };

    return sock;
}
