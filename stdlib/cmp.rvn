// stdlib/cmp.rvn - Value comparisons (inspired by Go's cmp package)

fn compare(a, b) {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}

fn less(a, b) {
    return a < b;
}

fn or_default(val, default_val) {
    if (val == nil || val == false || val == "") {
        return default_val;
    }
    return val;
}
