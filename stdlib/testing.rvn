// Raven Standard Library: Unit Testing Framework

let _test_passed_count = 0;
let _test_failed_count = 0;

fn describe(suite_name, fn_block) {
    print("▶ Suite: " + suite_name);
    fn_block();
    print("✓ Completed Suite: " + suite_name);
    print("");
}

fn test(test_name, fn_block) {
    try {
        fn_block();
        _test_passed_count = _test_passed_count + 1;
        print("  ✓ " + test_name);
    } catch (err) {
        _test_failed_count = _test_failed_count + 1;
        print("  ✗ " + test_name + " FAILED: " + err);
    }
}

fn expect_eq(actual, expected) {
    if (actual != expected) {
        throw "Expected " + str(expected) + " but got " + str(actual);
    }
}

fn expect_true(cond) {
    if (!cond) {
        throw "Expected condition to be true";
    }
}

fn expect_false(cond) {
    if (cond) {
        throw "Expected condition to be false";
    }
}

// Testify-style assertions (inspired by github.com/stretchr/testify)
fn assert_equal(expected, actual) {
    expect_eq(actual, expected);
}

fn assert_not_equal(a, b) {
    if (a == b) {
        throw "Expected values to be different, but both were " + str(a);
    }
}

fn assert_true(cond) {
    expect_true(cond);
}

fn assert_false(cond) {
    expect_false(cond);
}

fn assert_nil(val) {
    if (val != nil) {
        throw "Expected nil, but got " + str(val);
    }
}

fn assert_not_nil(val) {
    if (val == nil) {
        throw "Expected non-nil value, but got nil";
    }
}

fn assert_contains(container, elem) {
    if (!contains(container, elem)) {
        throw "Expected " + str(container) + " to contain " + str(elem);
    }
}
