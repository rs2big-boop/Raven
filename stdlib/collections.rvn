// Raven Standard Library: Collections & Data Structures
// Usage: import "stdlib/collections"

fn create_stack() {
    return {
        items: [],
        push: fn(val) { push(this.items, val); },
        pop: fn() { return pop(this.items); },
        peek: fn() {
            if (len(this.items) == 0) { return nil; }
            return this.items[len(this.items) - 1];
        },
        size: fn() { return len(this.items); },
        is_empty: fn() { return len(this.items) == 0; },
        to_array: fn() { return this.items; },
        clear: fn() { this.items = []; }
    };
}

fn create_queue() {
    return {
        items: [],
        enqueue: fn(val) { push(this.items, val); },
        dequeue: fn() {
            if (len(this.items) == 0) { return nil; }
            let front = this.items[0];
            let new_items = [];
            let i = 1;
            while (i < len(this.items)) {
                push(new_items, this.items[i]);
                i += 1;
            }
            this.items = new_items;
            return front;
        },
        peek: fn() {
            if (len(this.items) == 0) { return nil; }
            return this.items[0];
        },
        size: fn() { return len(this.items); },
        is_empty: fn() { return len(this.items) == 0; },
        to_array: fn() { return this.items; },
        clear: fn() { this.items = []; }
    };
}

fn create_set() {
    return {
        data: {},
        add: fn(val) { this.data[str(val)] = true; },
        has: fn(val) { return contains(this.data, str(val)); },
        remove: fn(val) { this.data[str(val)] = nil; },
        size: fn() {
            let count = 0;
            for (let k in keys(this.data)) {
                if (this.data[k]) { count += 1; }
            }
            return count;
        },
        to_array: fn() {
            let res = [];
            for (let k in keys(this.data)) {
                if (this.data[k]) { push(res, k); }
            }
            return res;
        },
        clear: fn() { this.data = {}; }
    };
}

fn create_deque() {
    return {
        items: [],
        push_back: fn(val) { push(this.items, val); },
        push_front: fn(val) {
            let new_items = [val];
            let i = 0;
            while (i < len(this.items)) {
                push(new_items, this.items[i]);
                i += 1;
            }
            this.items = new_items;
        },
        pop_back: fn() {
            if (len(this.items) == 0) { return nil; }
            return pop(this.items);
        },
        pop_front: fn() {
            if (len(this.items) == 0) { return nil; }
            let front = this.items[0];
            let new_items = [];
            let i = 1;
            while (i < len(this.items)) {
                push(new_items, this.items[i]);
                i += 1;
            }
            this.items = new_items;
            return front;
        },
        peek_back: fn() {
            if (len(this.items) == 0) { return nil; }
            return this.items[len(this.items) - 1];
        },
        peek_front: fn() {
            if (len(this.items) == 0) { return nil; }
            return this.items[0];
        },
        size: fn() { return len(this.items); },
        is_empty: fn() { return len(this.items) == 0; },
        clear: fn() { this.items = []; },
        to_array: fn() {
            let copy = [];
            for (let it in this.items) { push(copy, it); }
            return copy;
        }
    };
}

fn create_priority_queue() {
    return {
        heap: [],
        push: fn(item, priority) {
            let entry = { item, priority };
            push(this.heap, entry);
            let idx = len(this.heap) - 1;
            while (idx > 0) {
                let parent = int((idx - 1) / 2);
                if (this.heap[idx].priority < this.heap[parent].priority) {
                    let tmp = this.heap[idx];
                    this.heap[idx] = this.heap[parent];
                    this.heap[parent] = tmp;
                    idx = parent;
                } else {
                    break;
                }
            }
        },
        pop: fn() {
            if (len(this.heap) == 0) { return nil; }
            let root = this.heap[0].item;
            let last = pop(this.heap);
            if (len(this.heap) == 0) { return root; }
            this.heap[0] = last;

            let idx = 0;
            let n = len(this.heap);
            while (true) {
                let left = 2 * idx + 1;
                let right = 2 * idx + 2;
                let smallest = idx;

                if (left < n && this.heap[left].priority < this.heap[smallest].priority) {
                    smallest = left;
                }
                if (right < n && this.heap[right].priority < this.heap[smallest].priority) {
                    smallest = right;
                }

                if (smallest != idx) {
                    let tmp = this.heap[idx];
                    this.heap[idx] = this.heap[smallest];
                    this.heap[smallest] = tmp;
                    idx = smallest;
                } else {
                    break;
                }
            }
            return root;
        },
        peek: fn() {
            if (len(this.heap) == 0) { return nil; }
            return this.heap[0].item;
        },
        peek_priority: fn() {
            if (len(this.heap) == 0) { return nil; }
            return this.heap[0].priority;
        },
        size: fn() { return len(this.heap); },
        is_empty: fn() { return len(this.heap) == 0; },
        clear: fn() { this.heap = []; }
    };
}

fn create_linked_list() {
    return {
        head: nil,
        tail: nil,
        count: 0,
        push_back: fn(val) {
            let node = { value: val, prev: this.tail, next: nil };
            if (this.tail != nil) {
                this.tail.next = node;
            } else {
                this.head = node;
            }
            this.tail = node;
            this.count += 1;
        },
        push_front: fn(val) {
            let node = { value: val, prev: nil, next: this.head };
            if (this.head != nil) {
                this.head.prev = node;
            } else {
                this.tail = node;
            }
            this.head = node;
            this.count += 1;
        },
        pop_back: fn() {
            if (this.tail == nil) { return nil; }
            let val = this.tail.value;
            this.tail = this.tail.prev;
            if (this.tail != nil) {
                this.tail.next = nil;
            } else {
                this.head = nil;
            }
            this.count -= 1;
            return val;
        },
        pop_front: fn() {
            if (this.head == nil) { return nil; }
            let val = this.head.value;
            this.head = this.head.next;
            if (this.head != nil) {
                this.head.prev = nil;
            } else {
                this.tail = nil;
            }
            this.count -= 1;
            return val;
        },
        peek_front: fn() {
            if (this.head == nil) { return nil; }
            return this.head.value;
        },
        peek_back: fn() {
            if (this.tail == nil) { return nil; }
            return this.tail.value;
        },
        get: fn(index) {
            if (index < 0 || index >= this.count) { return nil; }
            let cur = this.head;
            let i = 0;
            while (i < index && cur != nil) {
                cur = cur.next;
                i += 1;
            }
            if (cur != nil) { return cur.value; }
            return nil;
        },
        size: fn() { return this.count; },
        is_empty: fn() { return this.count == 0; },
        to_array: fn() {
            let res = [];
            let cur = this.head;
            while (cur != nil) {
                push(res, cur.value);
                cur = cur.next;
            }
            return res;
        },
        clear: fn() {
            this.head = nil;
            this.tail = nil;
            this.count = 0;
        }
    };
}

fn _bst_insert_node(node, val) {
    if (node == nil) {
        return { val, left: nil, right: nil };
    }
    if (val < node.val) {
        node.left = _bst_insert_node(node.left, val);
    } else if (val > node.val) {
        node.right = _bst_insert_node(node.right, val);
    }
    return node;
}

fn _bst_in_order(node, acc) {
    if (node == nil) { return; }
    _bst_in_order(node.left, acc);
    push(acc, node.val);
    _bst_in_order(node.right, acc);
}

fn create_bst() {
    return {
        root: nil,
        count: 0,
        insert: fn(val) {
            if (!this.contains(val)) { this.count += 1; }
            this.root = _bst_insert_node(this.root, val);
        },
        contains: fn(val) {
            let cur = this.root;
            while (cur != nil) {
                if (val == cur.val) { return true; }
                if (val < cur.val) {
                    cur = cur.left;
                } else {
                    cur = cur.right;
                }
            }
            return false;
        },
        to_array: fn() {
            let acc = [];
            _bst_in_order(this.root, acc);
            return acc;
        },
        in_order: fn() {
            let res = [];
            _bst_in_order(this.root, res);
            return res;
        },
        min: fn() {
            if (this.root == nil) { return nil; }
            let cur = this.root;
            while (cur.left != nil) { cur = cur.left; }
            return cur.val;
        },
        max: fn() {
            if (this.root == nil) { return nil; }
            let cur = this.root;
            while (cur.right != nil) { cur = cur.right; }
            return cur.val;
        },
        size: fn() { return this.count; },
        is_empty: fn() { return this.count == 0; },
        clear: fn() { this.root = nil; this.count = 0; }
    };
}

fn _trie_create_node() {
    return { children: {}, is_end: false };
}

fn _trie_collect_words(node, prefix, acc) {
    if (node == nil) { return; }
    if (node.is_end) { push(acc, prefix); }
    let child_keys = keys(node.children);
    for (let ch in child_keys) {
        _trie_collect_words(node.children[ch], prefix + ch, acc);
    }
}

fn create_trie() {
    return {
        root: _trie_create_node(),
        word_count: 0,
        insert: fn(word) {
            let cur = this.root;
            let i = 0;
            let n = len(word);
            while (i < n) {
                let ch = word[i];
                if (!contains(cur.children, ch)) {
                    cur.children[ch] = _trie_create_node();
                }
                cur = cur.children[ch];
                i += 1;
            }
            if (!cur.is_end) {
                cur.is_end = true;
                this.word_count += 1;
            }
        },
        contains: fn(word) {
            let cur = this.root;
            let i = 0;
            let n = len(word);
            while (i < n) {
                let ch = word[i];
                if (!contains(cur.children, ch)) { return false; }
                cur = cur.children[ch];
                i += 1;
            }
            return cur.is_end;
        },
        starts_with: fn(prefix) {
            let cur = this.root;
            let i = 0;
            let n = len(prefix);
            while (i < n) {
                let ch = prefix[i];
                if (!contains(cur.children, ch)) { return false; }
                cur = cur.children[ch];
                i += 1;
            }
            return true;
        },
        words_with_prefix: fn(prefix) {
            let cur = this.root;
            let i = 0;
            let n = len(prefix);
            while (i < n) {
                let ch = prefix[i];
                if (!contains(cur.children, ch)) { return []; }
                cur = cur.children[ch];
                i += 1;
            }
            let matches = [];
            _trie_collect_words(cur, prefix, matches);
            return matches;
        },
        size: fn() { return this.word_count; },
        is_empty: fn() { return this.word_count == 0; }
    };
}

fn create_ring_buffer(cap) {
    if (cap <= 0) { cap = 1; }
    let buffer = [];
    let i = 0;
    while (i < cap) {
        push(buffer, nil);
        i += 1;
    }
    return {
        buffer: buffer,
        cap: cap,
        head: 0,
        tail: 0,
        count: 0,
        push: fn(val) {
            if (this.count == this.cap) {
                this.buffer[this.head] = val;
                this.head = (this.head + 1) % this.cap;
                this.tail = (this.tail + 1) % this.cap;
                return false;
            }
            this.buffer[this.tail] = val;
            this.tail = (this.tail + 1) % this.cap;
            this.count += 1;
            return true;
        },
        pop: fn() {
            if (this.count == 0) { return nil; }
            let val = this.buffer[this.head];
            this.buffer[this.head] = nil;
            this.head = (this.head + 1) % this.cap;
            this.count -= 1;
            return val;
        },
        peek: fn() {
            if (this.count == 0) { return nil; }
            return this.buffer[this.head];
        },
        size: fn() { return this.count; },
        capacity: fn() { return this.cap; },
        is_full: fn() { return this.count == this.cap; },
        is_empty: fn() { return this.count == 0; },
        to_array: fn() {
            let res = [];
            let cur = this.head;
            let c = 0;
            while (c < this.count) {
                push(res, this.buffer[cur]);
                cur = (cur + 1) % this.cap;
                c += 1;
            }
            return res;
        },
        clear: fn() {
            this.head = 0;
            this.tail = 0;
            this.count = 0;
            let j = 0;
            while (j < this.cap) {
                this.buffer[j] = nil;
                j += 1;
            }
        }
    };
}
