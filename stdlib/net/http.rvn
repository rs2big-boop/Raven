// stdlib/net/http.rvn - Modern HTTP client and server primitives for Raven
import "stdlib/net/http/status";
import "stdlib/net/http/headers";
import "stdlib/net/http/request";
import "stdlib/net/http/response";
import "stdlib/net/http/client";
import "stdlib/net/http/cookies";
import "stdlib/net/http/errors";
import "stdlib/net/http/server";

let default_client = create_client(nil);

// Legacy string return for backward compatibility
fn http_get_url(url) {
    let res = default_client.get(url, nil);
    return res["body"];
}

// Full response object with status, headers, body, json() helper
fn http_fetch(req_or_url) {
    if (type(req_or_url) == "string") {
        return default_client.get(req_or_url, nil);
    }
    return default_client.do_request(req_or_url);
}

// Standard post request
fn http_post(url, body) {
    let res = default_client.post(url, body, nil);
    return res["body"];
}

// Standard JSON post request
fn http_post_json(url, json_data) {
    let res = default_client.post_json(url, json_data, nil);
    return res["body"];
}

// Custom client constructor with configured timeouts, headers
fn new_http_client(opts) {
    return create_client(opts);
}

// HTTP Server constructor
fn new_http_server() {
    return create_http_server();
}
