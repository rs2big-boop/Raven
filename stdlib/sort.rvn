// Raven Standard Library - Sort Module

fn bubble_sort(arr) {
    let n = len(arr);
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr;
}

fn insertion_sort(arr) {
    let n = len(arr);
    let i = 1;
    while (i < n) {
        let key = arr[i];
        let j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
    return arr;
}

fn min_of_arr(arr) {
    if (len(arr) == 0) { return nil; }
    let m = arr[0];
    let i = 1;
    while (i < len(arr)) {
        if (arr[i] < m) { m = arr[i]; }
        i = i + 1;
    }
    return m;
}

fn max_of_arr(arr) {
    if (len(arr) == 0) { return nil; }
    let m = arr[0];
    let i = 1;
    while (i < len(arr)) {
        if (arr[i] > m) { m = arr[i]; }
        i = i + 1;
    }
    return m;
}
