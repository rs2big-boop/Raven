// stdlib/html.rvn - HTML escaping and template helpers (inspired by Go's html package)

fn html_escape(s) {
    let out = replace(s, "&", "&amp;");
    out = replace(out, "<", "&lt;");
    out = replace(out, ">", "&gt;");
    out = replace(out, "\"", "&quot;");
    out = replace(out, "'", "&#39;");
    return out;
}

fn html_unescape(s) {
    let out = replace(s, "&amp;", "&");
    out = replace(out, "&lt;", "<");
    out = replace(out, "&gt;", ">");
    out = replace(out, "&quot;", "\"");
    out = replace(out, "&#39;", "'");
    return out;
}

fn html_tag(tag_name, content) {
    return "<" + tag_name + ">" + content + "</" + tag_name + ">";
}
