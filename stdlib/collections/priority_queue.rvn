// Raven Collections: Priority Queue (Min-Heap by priority number)

fn create_priority_queue() {
    let heap = [];
    let pq = {};

    pq["push"] = fn(item, priority) {
        let entry = { "item": item, "priority": priority };
        push(heap, entry);
        let idx = len(heap) - 1;
        while (idx > 0) {
            let parent = int((idx - 1) / 2);
            if (heap[idx]["priority"] < heap[parent]["priority"]) {
                let tmp = heap[idx];
                heap[idx] = heap[parent];
                heap[parent] = tmp;
                idx = parent;
            } else {
                break;
            }
        }
    };

    pq["pop"] = fn() {
        if (len(heap) == 0) { return nil; }
        let root = heap[0]["item"];
        let last = pop(heap);
        if (len(heap) == 0) { return root; }
        heap[0] = last;

        let idx = 0;
        let n = len(heap);
        while (true) {
            let left = 2 * idx + 1;
            let right = 2 * idx + 2;
            let smallest = idx;

            if (left < n && heap[left]["priority"] < heap[smallest]["priority"]) {
                smallest = left;
            }
            if (right < n && heap[right]["priority"] < heap[smallest]["priority"]) {
                smallest = right;
            }

            if (smallest != idx) {
                let tmp = heap[idx];
                heap[idx] = heap[smallest];
                heap[smallest] = tmp;
                idx = smallest;
            } else {
                break;
            }
        }

        return root;
    };

    pq["peek"] = fn() {
        if (len(heap) == 0) { return nil; }
        return heap[0]["item"];
    };

    pq["peek_priority"] = fn() {
        if (len(heap) == 0) { return nil; }
        return heap[0]["priority"];
    };

    pq["size"] = fn() {
        return len(heap);
    };

    pq["is_empty"] = fn() {
        return len(heap) == 0;
    };

    pq["clear"] = fn() {
        heap = [];
    };

    return pq;
}
