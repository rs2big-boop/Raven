// stdlib/collections/set.rvn - Hash Set data structure

fn new_set() {
    let items = {};
    let count = 0;
    let s = {};

    s["add"] = fn(val) {
        let k = str(val);
        if (!map_has_key(items, k)) {
            items[k] = val;
            count = count + 1;
        }
    };

    s["has"] = fn(val) {
        return map_has_key(items, str(val));
    };

    s["remove"] = fn(val) {
        let k = str(val);
        if (map_has_key(items, k)) {
            map_delete(items, k);
            count = count - 1;
        }
    };

    s["size"] = fn() {
        return count;
    };

    s["to_array"] = fn() {
        return values(items);
    };

    s["clear"] = fn() {
        items = {};
        count = 0;
    };

    return s;
}
