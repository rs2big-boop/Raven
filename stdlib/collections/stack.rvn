// stdlib/collections/stack.rvn - LIFO Stack data structure

fn new_stack() {
    let items = [];
    let s = {};

    s.push = fn(val) {
        push(items, val);
    };

    s.pop = fn() {
        if (len(items) == 0) { return nil; }
        return pop(items);
    };

    s.peek = fn() {
        if (len(items) == 0) { return nil; }
        return items[len(items) - 1];
    };

    s.size = fn() {
        return len(items);
    };

    s.is_empty = fn() {
        return len(items) == 0;
    };

    s.clear = fn() {
        items = [];
    };

    return s;
}
