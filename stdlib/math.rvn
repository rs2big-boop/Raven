// Raven Standard Library: Advanced Math Module

let PI = 3.141592653589793;
let E  = 2.718281828459045;

fn abs(x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn max(a, b) {
    if (a > b) {
        return a;
    }
    return b;
}

fn min(a, b) {
    if (a < b) {
        return a;
    }
    return b;
}

fn pow(base, exp) {
    let res = 1;
    let i = 0;
    while (i < exp) {
        res = res * base;
        i = i + 1;
    }
    return res;
}

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn clamp(x, lo, hi) {
    if (x < lo) {
        return lo;
    }
    if (x > hi) {
        return hi;
    }
    return x;
}

fn deg_to_rad(deg) {
    return deg * (PI / 180.0);
}

fn rad_to_deg(rad) {
    return rad * (180.0 / PI);
}

fn hypot(a, b) {
    return sqrt(a * a + b * b);
}

fn sum(arr) {
    let s = 0;
    for (let x in arr) {
        s = s + x;
    }
    return s;
}

fn mean(arr) {
    let n = len(arr);
    if (n == 0) {
        return 0;
    }
    return sum(arr) / n;
}

fn variance(arr) {
    let n = len(arr);
    if (n <= 1) {
        return 0;
    }
    let m = mean(arr);
    let s = 0;
    for (let x in arr) {
        let diff = x - m;
        s = s + diff * diff;
    }
    return s / n;
}

fn std_dev(arr) {
    return sqrt(variance(arr));
}
