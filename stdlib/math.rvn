// Raven Standard Library: Math module

fn abs(x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn max(a, b) {
    if (a > b) {
        return a;
    }
    return b;
}

fn min(a, b) {
    if (a < b) {
        return a;
    }
    return b;
}

fn pow(base, exp) {
    let res = 1;
    let i = 0;
    while (i < exp) {
        res = res * base;
        i = i + 1;
    }
    return res;
}

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn clamp(x, lo, hi) {
    if (x < lo) {
        return lo;
    }
    if (x > hi) {
        return hi;
    }
    return x;
}
