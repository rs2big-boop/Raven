{
  "name": "raven-lang",
  "displayName": "Raven Language",
  "description": "Rich language support, LSP, formatter, linter, and runtime tools for the Raven Programming Language (.rvn)",
  "version": "1.0.0",
  "publisher": "raven-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/raven-lang/raven"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:raven",
    "onCommand:raven.run",
    "onCommand:raven.debug",
    "onCommand:raven.fmt",
    "onCommand:raven.vet"
  ],
  "contributes": {
    "languages": [
      {
        "id": "raven",
        "aliases": ["Raven", "raven"],
        "extensions": [".rvn"],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "raven",
        "path": "./snippets/raven.json"
      }
    ],
    "grammars": [
      {
        "language": "raven",
        "scopeName": "source.raven",
        "path": "./syntaxes/raven.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "raven.run",
        "title": "Raven: Run Current File",
        "icon": "$(play)",
        "category": "Raven"
      },
      {
        "command": "raven.debug",
        "title": "Raven: Debug Current File (Interactive rvndb)",
        "icon": "$(debug-alt)",
        "category": "Raven"
      },
      {
        "command": "raven.fmt",
        "title": "Raven: Format Current File (gofmt style)",
        "category": "Raven"
      },
      {
        "command": "raven.vet",
        "title": "Raven: Lint / Vet Current File (go vet style)",
        "category": "Raven"
      },
      {
        "command": "raven.doc",
        "title": "Raven: Generate API Documentation (godoc style)",
        "category": "Raven"
      },
      {
        "command": "raven.bench",
        "title": "Raven: Benchmark Current File",
        "category": "Raven"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "raven.run",
          "when": "resourceLangId == raven",
          "group": "navigation@1"
        },
        {
          "command": "raven.debug",
          "when": "resourceLangId == raven",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "raven.run",
          "when": "resourceLangId == raven",
          "group": "navigation@1"
        },
        {
          "command": "raven.debug",
          "when": "resourceLangId == raven",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "raven.run",
          "when": "resourceLangId == raven",
          "group": "navigation@1"
        },
        {
          "command": "raven.debug",
          "when": "resourceLangId == raven",
          "group": "navigation@2"
        },
        {
          "command": "raven.fmt",
          "when": "resourceLangId == raven",
          "group": "1_modification@1"
        },
        {
          "command": "raven.vet",
          "when": "resourceLangId == raven",
          "group": "1_modification@2"
        }
      ]
    },
    "debuggers": [
      {
        "type": "raven",
        "label": "Raven Debugger (rvndb)",
        "languages": ["raven"],
        "configurationSnippets": [
          {
            "label": "Raven: Debug Current File",
            "description": "Debug the active Raven file using rvndb",
            "body": {
              "type": "raven",
              "request": "launch",
              "name": "Raven: Debug Current File",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Raven script to debug",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically pause execution at the first line",
                "default": true
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the script",
                "items": { "type": "string" },
                "default": []
              }
            }
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "raven"
      }
    ],
    "keybindings": [
      {
        "command": "raven.run",
        "key": "shift+f5",
        "when": "editorLangId == raven"
      },
      {
        "command": "raven.debug",
        "key": "f5",
        "when": "editorLangId == raven"
      }
    ],
    "configuration": {
      "title": "Raven",
      "properties": {
        "raven.executablePath": {
          "type": "string",
          "default": "/home/ran/Raven/build/raven",
          "description": "Path to the raven CLI executable"
        },
        "raven.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically format Raven files on save"
        }
      }
    }
  }
}
