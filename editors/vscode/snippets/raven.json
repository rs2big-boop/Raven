{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "    ${0:// code}",
      "}"
    ],
    "description": "Define a function"
  },
  "Map Shorthand": {
    "prefix": "map",
    "body": [
      "let ${1:node} = { ${2:data}, ${3:next} };"
    ],
    "description": "Object / map with shorthand fields"
  },
  "Method With This": {
    "prefix": "this",
    "body": [
      "${1:get}: fn() {",
      "    return this.${2:data};",
      "}"
    ],
    "description": "Object method using this"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} { ${2:field1}, ${3:field2} };"
    ],
    "description": "Declare a struct"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${0:// code}",
      "}"
    ],
    "description": "While loop"
  },
  "For-In Loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:item} in ${2:iterable}) {",
      "    ${0:// code}",
      "}"
    ],
    "description": "For-in loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${0:// code}",
      "}"
    ],
    "description": "If statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2:// code}",
      "} else {",
      "    ${0:// code}",
      "}"
    ],
    "description": "If-else statement"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "let ${1:result} = match (${2:value}) {",
      "    ${3:pattern} => ${4:expression},",
      "    _ => ${0:default_expr}",
      "};"
    ],
    "description": "Pattern matching expression"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${1:// code}",
      "} catch (${2:err}) {",
      "    ${0:// handle error}",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Import Statement": {
    "prefix": "import",
    "body": [
      "import \"stdlib/${1:fmt}\";"
    ],
    "description": "Import a module"
  }
}
